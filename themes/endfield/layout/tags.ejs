<article class="tag-page">
  <h1 class="tag-title"><%= page.title || "标签" %></h1>
  <ul class="tag-cloud">
    <% site.tags.each(function(t){ %>
      <li><a href="<%- url_for(t.path) %>"><span class="tagname">#<%= t.name %></span><span class="tagcount"><%= t.length %></span></a></li>
    <% }); %>
  </ul>
</article>
