<article class="post-page" itemscope itemtype="http://schema.org/Article">
  <header class="post-header">
    <h1 class="post-title" itemprop="headline"><%= page.title %></h1>
    <div class="post-meta">
      <time datetime="<%= date_xml(page.date) %>" itemprop="datePublished"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.author) { %><span>·</span><span itemprop="author"><%= page.author %></span><% } %>
      <% if (page.tags && page.tags.length) { %>
        <span class="post-tags">
          <%- page.tags.map(function(t){ return '<a class="tag" href="' + url_for(t.path) + '">#' + t.name + '</a>'; }).join(' ') %>
        </span>
      <% } %>
    </div>
  </header>

  <% if (theme.toc.enable) { %>
    <% var toc_html = toc(page.content, {depth: theme.toc.depth, class: 'toc', min: 1}); %>
    <% if (toc_html && toc_html.length > 40) { %>
      <nav class="post-toc">
        <details open>
          <summary>目录</summary>
          <%- toc_html %>
        </details>
      </nav>
    <% } %>
  <% } %>

  <div class="post-content" itemprop="articleBody">
    <%- page.content %>
  </div>

  <% /* 相关文章: 站内内链, 利于搜索引擎顺链接爬取 */ %>
  <% var _others = []; site.posts.each(function(p){ if(p.path !== page.path && _others.length < 5) _others.push(p); }); %>
  <% if (_others.length) { %>
    <nav class="post-related">
      <h2 class="post-related-title">相关文章</h2>
      <ul class="post-related-list">
        <% _others.forEach(function(p){ %>
          <li><a href="<%- url_for(p.path) %>"><%= p.title || p.slug %></a>
            <time><%= date(p.date, 'YYYY-MM-DD') %></time></li>
        <% }); %>
      </ul>
    </nav>
  <% } %>

  <% if (theme.creative_commons && theme.creative_commons.license) { %>
    <div class="post-license">
      本文采用 <a href="https://creativecommons.org/licenses/<%= theme.creative_commons.license %>/deed.zh" target="_blank" rel="noopener"><%= theme.creative_commons.license.toUpperCase() %></a> 许可
    </div>
  <% } %>
</article>
