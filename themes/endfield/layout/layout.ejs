<%
  var pageTitle;
  if (is_home()) {
    pageTitle = config.title + (config.subtitle ? " · " + config.subtitle : "");
  } else {
    var t = page.title;
    if (!t) {
      if (page.tag) t = "#" + page.tag;
      else if (page.category) t = page.category;
      else if (page.layout === "tags") t = "标签";
      else if (page.layout === "categories") t = "分类";
      else if (page.archive) t = "归档";
      else t = config.title;
    }
    pageTitle = t + " · " + config.title;
  }
  var ogTitle = is_home() ? config.title : (page.title || (page.tag ? ("#" + page.tag) : (page.category || "归档")));
%>
<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= (page.description || page.title || config.description).toString() %>">
  <meta name="keywords" content="<%= config.keywords %>">
  <meta property="og:type" content="<%= is_post() ? "article" : "website" %>">
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:url" content="<%- is_home() ? config.url + "/" : page.permalink %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:description" content="<%= (page.description || page.title || config.description).toString() %>">
  <meta property="og:locale" content="zh_CN">
  <meta name="twitter:card" content="summary">
  <link rel="canonical" href="<%- is_home() ? config.url + "/" : page.permalink %>">
  <link rel="alternate" href="<%- url_for("atom.xml") %>" type="application/atom+xml" title="<%= config.title %>">
  <% if (theme.verification.baidu) { %><meta name="baidu-site-verification" content="<%= theme.verification.baidu %>"><% } %>
  <% if (theme.verification.bing) { %><meta name="msvalidate.01" content="<%= theme.verification.bing %>"><% } %>
  <% if (theme.verification.google) { %><meta name="google-site-verification" content="<%= theme.verification.google %>"><% } %>
  <link rel="stylesheet" href="/css/main.css?v=20261122b">
  <link rel="stylesheet" href="/css/endfield.css?v=20261124i">
  <style>:root{--accent:<%= theme.accent_color || "#fffa00" %>;<%= theme.font && theme.font.sans ? "--font-sans:"+theme.font.sans+";" : "" %><%= theme.font && theme.font.mono ? "--font-mono:"+theme.font.mono+";" : "" %>}</style>
</head>
<body data-theme="<%= theme.dark_mode.default %>" class="ef-theme">
<div class="ef-loader" id="efLoader">
  <div class="ef-loader-inner">
    <img class="ef-loader-avatar" src="/images/loader-avatar.webp" alt="">
