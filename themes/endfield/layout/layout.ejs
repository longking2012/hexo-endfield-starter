    <div class="ef-loader-bar"><i id="efBar"></i></div>
    <div class="ef-loader-foot"><span class="ef-loader-lb">LOADING</span><span id="efPct">0%</span></div>
  </div>
</div>
<script src="/js/ef-loader.js?v=20261123p"></script>
